# Copie este arquivo para .env e substitua TODOS os placeholders antes de iniciar.
# Nunca versione .env. O Compose rejeita valores obrigatórios ausentes/vazios.
DB_NAME=servicehub
DB_USERNAME=servicehub
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_DO_BANCO

# Gere 32 bytes aleatórios codificados em Base64 (não use o texto abaixo).
# PowerShell (5.1 ou 7):
# $bytes = New-Object byte[] 32; $rng = [Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($bytes); [Convert]::ToBase64String($bytes); $rng.Dispose()
# OpenSSL: openssl rand -base64 32
JWT_SECRET=SUBSTITUA_POR_BASE64_DE_32_BYTES_ALEATORIOS
JWT_EXPIRATION_SECONDS=86400
API_PORT=8080

# Opcionais, sempre em conjunto: cria o PRIMEIRO administrador, caso não exista.
# Use uma senha com ao menos 8 caracteres, maiúscula e número (máx. 72 bytes).
# Após o primeiro início, deixe ambos vazios e reinicie a API.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Para rodar a API pelo Maven fora do Docker:
DB_URL=jdbc:postgresql://localhost:5433/servicehub
