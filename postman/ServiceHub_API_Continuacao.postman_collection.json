          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{providerEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const response = pm.response.json();",
              "pm.test(\"JWT e usuário provider presentes\", function () { pm.expect(response.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(response.tokenType.toLowerCase()).to.eql(\"bearer\"); pm.expect(response.user.id).to.exist; });",
              "if (pm.response.code === 200 && response.accessToken && response.user) { pm.environment.set(\"providerToken\", response.accessToken); pm.environment.set(\"providerId\", String(response.user.id)); }",
              "pm.test(\"Login não expõe senha\", function () { pm.expect(response.user).not.to.have.property(\"password\"); pm.expect(response.user).not.to.have.property(\"passwordHash\"); });"
            ]
          }
        }
      ]
    },
